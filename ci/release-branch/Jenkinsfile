pipeline {
    agent {
        kubernetes {
            yamlFile 'ci/release-branch/kubernetes.yaml'
        }
    }

    options {
        timeout(time: 120, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '3'))
    }

    parameters {
        string description: 'Release Version. Format: <major>.<minor>', name: 'ReleaseVersion', trim: true
    }


    stages {
        stage('Create Release Branch') {
            steps {
                container('github') {
                    withCredentials([string(credentialsId: 'github-bot-token', variable: 'GITHUB_TOKEN')]) {
                        sh "gh workflow run create-release-branch.yml --repo eclipse-set/browser -f citag=[${params.ReleaseVersion}] -f version=${params.ReleaseVersion}"
                        sh "gh workflow run create-release-branch.yml --repo eclipse-set/model -f citag=[${params.ReleaseVersion}] -f version=${params.ReleaseVersion}"
                        sh "gh workflow run create-release-branch.yml --repo eclipse-set/set -f citag=[${params.ReleaseVersion}] -f version=${params.ReleaseVersion}"
                        sh "gh workflow run create-release-branch.yml --repo eclipse-set/plazlst -f citag=[${params.ReleaseVersion}] -f version=${params.ReleaseVersion}"
                    }
                }
            }
        }
    }
}
